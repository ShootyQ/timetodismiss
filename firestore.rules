rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Collection group access for student events (used by analytics Session Metrics)
    // Relies on orgId/schoolId fields stored in each event document
    match /orgs/{orgId}/schools/{schoolId}/{rest=**}/events/{eventId} {
      allow get, list: if isAuthed() && isAtLeastViewer() && inSchool(orgId, schoolId);
      // Mirror create rule here for any writes that may use collection group paths (normally writes go via students/{id}/events)
      allow create: if isAuthed()
                     && isAtLeastViewer()
                     && inSchool(orgId, schoolId)
                     && request.resource.data.keys().hasOnly(['status','at','sessionId','orgId','schoolId','studentId','classId','studentName'])
                     && (request.resource.data.status is string)
                     && ('at' in request.resource.data);
      allow update, delete: if false;
    }

    // Generic collection group rule for events to support any nested parent path.
    // Uses orgId/schoolId embedded in the document to evaluate tenant scope.
    match /{anyPath=**}/events/{eventId} {
      allow get, list: if isAuthed() && isAtLeastViewer() && inSchool(resource.data.orgId, resource.data.schoolId);
      allow create: if isAuthed()
                     && isAtLeastViewer()
                     && inSchool(request.resource.data.orgId, request.resource.data.schoolId)
                     && request.resource.data.keys().hasOnly(['status','at','sessionId','orgId','schoolId','studentId','classId','studentName'])
                     && (request.resource.data.status is string)
                     && ('at' in request.resource.data);
      allow update, delete: if false;
    }

    // ───────────── Helpers ─────────────
    function isAuthed() { return request.auth != null; }

    function hasRole(r) {
      return request.auth.token.role == r ||
             (request.auth.token.roles != null && request.auth.token.roles.hasAny([r])) ||
             (r == 'owner'          && request.auth.token.owner == true) ||
             (r == 'superintendent' && request.auth.token.superintendent == true) ||
             (r == 'admin'          && request.auth.token.admin == true) ||
             (r == 'caller'         && request.auth.token.caller == true) ||
             (r == 'viewer'         && request.auth.token.viewer == true);
    }

    function isOwner()  { return isAuthed() && hasRole('owner'); }
    function isSup()    { return isAuthed() && hasRole('superintendent'); }
    function isAdmin()  { return isAuthed() && hasRole('admin'); }
    function isCaller() { return isAuthed() && hasRole('caller'); }
    function isViewer() { return isAuthed() && hasRole('viewer'); }

    function isAtLeastViewer() { return isOwner() || isSup() || isAdmin() || isCaller() || isViewer(); }
    function isAtLeastCaller() { return isOwner() || isSup() || isAdmin() || isCaller(); }
    function isAtLeastAdmin()  { return isOwner() || isSup() || isAdmin(); }

    function inOrg(orgId) {
      return isOwner() ||
             (request.auth.token.orgId == orgId) ||
             (request.auth.token.orgIds != null && request.auth.token.orgIds.hasAny([orgId]));
    }

    function inSchool(orgId, schoolId) {
      return inOrg(orgId) && (
        isAtLeastAdmin() ||
        request.auth.token.schoolId == schoolId ||
        (request.auth.token.schoolIds != null && request.auth.token.schoolIds.hasAny([schoolId]))
      );
    }

    // Allow a signed-in guardian to access their student's doc even if they don't have school membership claims
    function isGuardianOfStudent(orgId, schoolId, studentId) {
      return isAuthed() && exists(/databases/$(database)/documents/orgs/$(orgId)/schools/$(schoolId)/students/$(studentId)/guardians/$(request.auth.uid));
    }

    // Viewer-limited flip: called → en_route with server time only
    function canViewerFlipToEnRoute() {
      return resource.data.status == 'called' &&
             request.resource.data.status == 'en_route' &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt']) &&
             request.resource.data.updatedAt == request.time;
    }

    // Viewer-limited toggle for Absent: allow called ↔ absent with server time only
    // This permits non-caller viewers to mark a student absent and undo it back to called,
    // while forbidding any other field changes or status transitions.
    function canViewerToggleAbsent() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt']) &&
             request.resource.data.updatedAt == request.time &&
             (
               (resource.data.status == 'called' && request.resource.data.status == 'absent') ||
               (resource.data.status == 'absent' && request.resource.data.status == 'called')
             );
    }

    // Allow a teacher (not necessarily caller/admin) to update ONLY preferredName or callSound (plus updatedAt)
    // if the student is in one of the teacher's assigned classes listed in the member doc.
    function isTeacherForStudent(orgId, schoolId) {
      // Fetch the teacher's membership doc once; if missing fields, deny.
      return isAuthed() &&
             get(/databases/$(database)/documents/orgs/$(orgId)/schools/$(schoolId)/members/$(request.auth.uid)).data.teacher.classIds.hasAny([resource.data.classId]) &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['preferredName','callSound','updatedAt']);
    }

    // Allow a classroom teacher to mark a student Absent for their own class.
    // Restricts the write to only the 'status' field (set to 'absent') plus 'updatedAt'.
    function canTeacherMarkAbsent(orgId, schoolId) {
      return isAuthed() && inSchool(orgId, schoolId) &&
             get(/databases/$(database)/documents/orgs/$(orgId)/schools/$(schoolId)/members/$(request.auth.uid)).data.teacher.classIds.hasAny([resource.data.classId]) &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt']) &&
             request.resource.data.status == 'absent';
    }

    // ───────────── Orgs & Schools ─────────────
    match /orgs/{orgId} {
      // Owner can always see; others must be scoped to the org
      allow get:  if isAuthed() && (isOwner() || (inOrg(orgId) && isAtLeastViewer()));
      allow list: if isAuthed() && (isOwner() || (isSup() && inOrg(orgId)));
      allow create, update, delete: if false;

      // Org-level members (no recursive get()-checks)
      match /members/{uid} {
        allow get:  if isAuthed() && (request.auth.uid == uid || isOwner() || (isSup() && inOrg(orgId)));
        allow list: if isAuthed() && (isOwner() || (isSup() && inOrg(orgId)));
        allow create, update, delete: if false;
      }

      match /schools/{schoolId} {
        allow get:  if isAuthed() && inSchool(orgId, schoolId);
        allow list: if isAuthed() && (isOwner() || (isSup() && inOrg(orgId)));
        allow create, update, delete: if false;

        match /members/{memberId} {
          allow get:  if isAuthed() && (
                        request.auth.uid == memberId ||
                        isOwner() ||
                        (isSup() && inOrg(orgId)) ||
                        (isAdmin() && inSchool(orgId, schoolId))
                      );
          allow list: if isAuthed() && (isOwner() || (isSup() && inOrg(orgId)) || (isAdmin() && inSchool(orgId, schoolId)));
       // Admin / superintendent / owner full writes; plus self limited prefs-only writes.
       // Split create vs update because diff() is undefined on create when resource doesn't exist.
       allow create: if (
         isAuthed() && isAtLeastAdmin() && inSchool(orgId, schoolId)
       ) || (
         isAuthed() && request.auth.uid == memberId && inSchool(orgId, schoolId) &&
         request.resource.data.keys().hasOnly(['prefs'])
       );
       allow update: if (
         isAuthed() && isAtLeastAdmin() && inSchool(orgId, schoolId)
       ) || (
         isAuthed() && request.auth.uid == memberId && inSchool(orgId, schoolId) &&
         request.resource.data.diff(resource.data).changedKeys().hasOnly(['prefs'])
       );
       allow delete: if isAuthed() && isAtLeastAdmin() && inSchool(orgId, schoolId);

          // Per-teacher private nicknames for students (viewer+ allowed for own subcollection)
          // Path: orgs/{orgId}/schools/{schoolId}/members/{memberId}/nicknames/{studentId}
          match /nicknames/{studentId} {
            // Only the owning teacher (memberId == auth.uid) may read/write; must belong to school
            allow get, list: if isAuthed() && request.auth.uid == memberId && inSchool(orgId, schoolId);
            // NOTE: serverTimestamp() appears as a special sentinel during evaluation and is NOT a timestamp yet.
            // We therefore cannot require `updatedAt is timestamp` on the incoming write. Instead ensure the field exists
            // and rely on write history / client usage for freshness.
            allow create, update: if isAuthed()
                                   && request.auth.uid == memberId
                                   && inSchool(orgId, schoolId)
                                   && request.resource.data.keys().hasOnly(['name','sound','updatedAt'])
                                   && ('updatedAt' in request.resource.data)
                                   && ( !('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60) )
                                   && ( !('sound' in request.resource.data) || (request.resource.data.sound is string && request.resource.data.sound.size() <= 80) );
            allow delete: if isAuthed() && request.auth.uid == memberId && inSchool(orgId, schoolId);
          }
        }

        // CLASSES
        match /classes/{classId} {
          allow get, list: if isAuthed() && inSchool(orgId, schoolId);
          allow create, update, delete: if isAuthed() && inSchool(orgId, schoolId) && isAtLeastCaller();
        }

        // STUDENTS
        match /students/{studentId} {
          // Viewers/callers/admins in school OR the student's linked guardians may read the student doc
          allow get:  if isAuthed() && (inSchool(orgId, schoolId) || isGuardianOfStudent(orgId, schoolId, studentId));
          // Listing restricted to staff scoped to school
          allow list: if isAuthed() && inSchool(orgId, schoolId);
          // Update allowed for callers/admins (full status changes), viewers limited flips (en_route, absent),
          // and teachers limited to preferredName/callSound or marking absent for their class.
          allow update: if isAuthed() && inSchool(orgId, schoolId) && (
            isAtLeastCaller() ||
            canViewerFlipToEnRoute() ||
            canViewerToggleAbsent() ||
            isTeacherForStudent(orgId, schoolId) ||
            canTeacherMarkAbsent(orgId, schoolId)
          );
          allow create, delete: if isAuthed() && inSchool(orgId, schoolId) && isAtLeastCaller();

          // Per-student events subcollection used for analytics (collectionGroup queries)
          match /events/{eventId} {
            // Anyone at least viewer within the school can append minimal event docs (status transition logging)
            allow create: if isAuthed() && inSchool(orgId, schoolId) && isAtLeastViewer() &&
                          request.resource.data.keys().hasOnly(['status','at','sessionId','orgId','schoolId','studentId','classId','studentName']) &&
                          (request.resource.data.status is string) && ('at' in request.resource.data);
            allow get, list: if isAuthed() && inSchool(orgId, schoolId);
            allow update, delete: if false; // append-only
          }

          // Trusted adult / access grants collection under school scope
          // Path: orgs/{orgId}/schools/{schoolId}/accessGrants/{grantId}
          // Server-only writes via Cloud Functions; clients (grantor or grantee) may read.
          match /accessGrants/{grantId} {
            allow get: if isAuthed() && (
              inSchool(orgId, schoolId) && isAtLeastViewer() ||
              // Grantor or grantee may always read regardless of explicit school membership claims
              (request.auth.uid == resource.data.grantorUid) ||
              (request.auth.uid == resource.data.granteeUid)
            );
            allow list: if isAuthed() && (
              inSchool(orgId, schoolId) && isAtLeastViewer() ||
              // Listing constrained to grantor - filter applied client-side (reads are non-sensitive: only metadata)
              (request.query == null && request.auth.uid == resource.data.grantorUid)
            );
            allow create, update, delete: if false; // server-only
          }
        }

        // SETTINGS
        match /settings/{docId} {
          allow get: if isAuthed() && inSchool(orgId, schoolId);
          allow create, update, delete: if isAuthed() && inSchool(orgId, schoolId) && isAtLeastAdmin();
        }

        // Student daily stats (per-day aggregation docs written client-side today)
        match /studentStats/{statId} {
          allow get, list: if isAuthed() && inSchool(orgId, schoolId);
          // Allow writes from caller/admin/viewer to update analytics timestamps and denormalized fields
          allow create, update: if isAuthed() && inSchool(orgId, schoolId) && isAtLeastViewer() &&
                                 request.resource.data.keys().hasOnly(['firstStatus','lastStatus','updatedAt','calledAt','enRouteAt','pickedUpAt','classId','studentName']);
          allow delete: if isAuthed() && inSchool(orgId, schoolId) && isAtLeastAdmin();
        }

        // Catch-all subcollections
        match /{sub}/{doc} {
          allow get, list: if isAuthed() && inSchool(orgId, schoolId);
          allow create, update, delete: if isAuthed() && inSchool(orgId, schoolId) && isAtLeastCaller();
        }
      }
    }

    // Users / Invites
    match /users/{userId} {
      allow get: if isOwner() || (isAuthed() && request.auth.uid == userId);
      allow list, create, update, delete: if false;
    }
    // Reverse index for guardian links written by Cloud Functions at claim time
    // Path: users/{uid}/guardianLinks/{orgId__schoolId__studentId}
    match /users/{userId}/guardianLinks/{linkId} {
      allow get, list: if isAuthed() && request.auth.uid == userId;
      allow create, update, delete: if false; // server-only (admin SDK bypasses rules)
    }
    match /invites/{inviteId} {
      allow get: if isOwner() || (isAuthed() && request.auth.token.email == resource.data.email);
      allow list, create, update, delete: if false;
    }

    // Guardians: allow a signed-in user to read their own guardian links via collection group
    // Guardians docs store { uid, orgId, schoolId, ... } so we can scope access
    match /{anyPath=**}/guardians/{uid} {
      // Guardians may read their own link docs regardless of school membership claims
      allow get, list: if isAuthed() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Domain mapping (used by header fallback)
    match /domains/{domain} {
      allow get: if isAuthed();
      allow list, create, update, delete: if false;
    }

    // Legacy top-level schools (read-only during migration)
    match /schools/{schoolId} {
      allow get, list: if isAuthed();
      allow create, update, delete: if false;
    }
    match /schoolDomains/{domain} {
      allow get: if isAtLeastAdmin();
      allow list, create, update, delete: if false;
    }
  }
}
